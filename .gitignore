# Local Python environments
.venv/
.venv-local/
.venv*/

# Secrets and local environment settings
.env
.env.*
!.env.example

# Python caches, test output, and build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.tox/
.nox/

# Editor and OS files
.idea/
.vscode/
Thumbs.db
Desktop.ini

# Frontend dependencies and generated bundles
frontend/node_modules/
frontend/dist/

# Local and user-provided datasets
datasets/**/raw/*
datasets/**/processed/*
!datasets/**/raw/.gitkeep
!datasets/**/processed/.gitkeep
datasets/community/*
!datasets/community/.gitkeep
outputs/*
!outputs/.gitkeep
*.duckdb
