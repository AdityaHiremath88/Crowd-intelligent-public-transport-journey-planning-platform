CROWDWISE_DATABASE_PATH=datasets/processed/crowdwise.duckdb
CROWDWISE_ETM_CSV=datasets/etm/raw/October-Delhi.csv
CROWDWISE_GTFS_ZIP=datasets/gtfs/raw/delhi_buses_static_gtfs_v1.zip
CROWDWISE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CROWDWISE_COMMUNITY_DB_PATH=datasets/community/crowdwise_signals.sqlite3
# Optional authorized GTFS-Realtime VehiclePositions feed. Leave blank until access is granted.
CROWDWISE_GTFS_RT_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
DELHI_BUS_API_KEY=
CROWDWISE_GTFS_RT_AUTH_MODE=header
CROWDWISE_GTFS_RT_AUTH_HEADER=x-api-key
CROWDWISE_GTFS_RT_KEY_PARAMETER=key
CROWDWISE_GTFS_RT_POLL_SECONDS=30
CROWDWISE_GTFS_RT_TIMEOUT_SECONDS=8
CROWDWISE_GTFS_RT_MAX_STALENESS_SECONDS=180
# Generate a long random secret for stable HMAC deduplication across restarts; never commit a real value.
CROWDWISE_REPORT_HMAC_SECRET=
CROWDWISE_REPORT_TTL_SECONDS=1200
CROWDWISE_PRESENCE_TTL_SECONDS=600
CROWDWISE_COMMUNITY_RATE_LIMIT_PER_HOUR=10
CROWDWISE_COMMUNITY_NETWORK_RATE_LIMIT_PER_HOUR=100
CROWDWISE_GEOFENCE_RADIUS_METERS=100

# Yuktix backend v2 uses its own local GTFS database while it is developed beside the existing API.
YUKTIX_V2_DATABASE_PATH=datasets/processed/yuktix_v2.duckdb
YUKTIX_V2_GTFS_ZIP=datasets/gtfs/raw/delhi_buses_static_gtfs_v1.zip
YUKTIX_V2_GTFS_REPORT=outputs/yuktix_v2_gtfs_import.json
YUKTIX_V2_ETM_BUNDLE=datasets/etm/raw/yuktix-october-delhi-clean-data.zip
YUKTIX_V2_ETM_REPORT=outputs/yuktix_v2_etm_import.json
YUKTIX_V2_FARE_STAGES_XLSX=datasets/etm/raw/dtc-route-fare-stage-master.xlsx
YUKTIX_V2_FARE_STAGE_REPORT=outputs/yuktix_v2_fare_stage_import.json
YUKTIX_V2_CORS_ORIGINS=http://localhost:5173

