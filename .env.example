CROWDWISE_DATABASE_PATH=datasets/processed/crowdwise.duckdb
CROWDWISE_ETM_CSV=datasets/etm/raw/October-Delhi.csv
CROWDWISE_GTFS_ZIP=datasets/gtfs/raw/delhi_buses_static_gtfs_v1.zip
CROWDWISE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CROWDWISE_COMMUNITY_DB_PATH=datasets/community/crowdwise_signals.sqlite3
# Optional authorized Delhi Transport Stack VehiclePositions feed.
# Leave the key blank until access is granted. The key is sent only by the backend.
DELHI_GTFS_RT_URL=https://delhi.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
DELHI_GTFS_RT_API_KEY=
CROWDWISE_GTFS_RT_AUTH_MODE=header
CROWDWISE_GTFS_RT_AUTH_HEADER=x-api-key
CROWDWISE_GTFS_RT_KEY_PARAMETER=key
CROWDWISE_GTFS_RT_POLL_SECONDS=60
CROWDWISE_GTFS_RT_TIMEOUT_SECONDS=8
CROWDWISE_GTFS_RT_MAX_STALENESS_SECONDS=180
# Generate a long random secret for stable HMAC deduplication across restarts; never commit a real value.
CROWDWISE_REPORT_HMAC_SECRET=
CROWDWISE_REPORT_TTL_SECONDS=1200
CROWDWISE_PRESENCE_TTL_SECONDS=600
CROWDWISE_COMMUNITY_RATE_LIMIT_PER_HOUR=10
CROWDWISE_COMMUNITY_NETWORK_RATE_LIMIT_PER_HOUR=100
CROWDWISE_GEOFENCE_RADIUS_METERS=100



